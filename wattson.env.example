# Copy to wattson.env (gitignored) and adjust. Every value has a working
# default in scripts/model_test.py for the current Olares host, so an empty
# or absent file is fine.

# OpenAI-compatible base URL of the local inference backend (llama.cpp /v1)
WATTSON_MODEL_BASE_URL=https://366ada1d.app.on.bigrock.dev/v1

# Model id exactly as listed by GET {base}/models
WATTSON_MODEL_NAME=unsloth/Qwen3.8-27B-GGUF:UD-Q4_K_XL

# Only set if the endpoint starts requiring auth
# WATTSON_MODEL_API_KEY=
